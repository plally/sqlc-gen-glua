{{define "queryFunc"}}
---@class {{.GlobalLuaTable}}Queries
{{range .Comments}}
-- {{ . }}
{{- end }}
{{- if .Params}}
---@param params {{.ParamsType}}
{{- end}}
---@param callback fun(result: {{.ReturnType}}?, err: string|nil)
function {{.GlobalLuaTable}}Queries:{{.Name}}({{- if .Params }}params, {{end -}}callback)
    callback = callback or function() end

    local argCount = {{.ParamCount}}

	local query = [[
	{{.Query}}
	]]
{{- range .Params -}}
	{{- if .IsSqlcSlice}}
	query = string.Replace(query, "/*SLICE:{{.Name}}*/?", string.sub(repeatString(",?", #params.{{.Name}}), 2))
    argCount = argCount + #params.{{.Name}} - 1

	{{- end -}}
{{- end}}

	self:runQuery(query, {
{{- range .Params}}
        {{if .IsSqlcSlice}}unpack(params.{{.Name}}),
        {{- else -}}params.{{.Name}},
        {{- end -}}
{{end}} 
    }, argCount, function(rows, err)
        if err then
            callback(nil, err)
            return
        end

        {{- if eq .ReturnType "nil" }}
        callback(nil, nil)
        {{- else if .ReturnsSlice }}
        {{- if .ReturnMappings }}

        local results = {}
        for _, row in ipairs(rows) do
            local result = {
            {{- range $oldName, $newName := .ReturnMappings }}
                ["{{ $newName }}"] = row["{{ $oldName }}"],
            {{- end }}
            }
            table.insert(results, result)
        end
        callback(results, nil)
        {{- else }}
        callback(rows, nil)
        {{- end }}
        {{- else }}
        {{- if .ReturnMappings }}
        if #rows == 0 then
            callback(nil, nil)
            return
        end
        local row = rows[1]
        local result = {
            {{- range $oldName, $newName := .ReturnMappings }}
            ["{{ $newName }}"] = row["{{ $oldName }}"],
            {{- end }}
        }
        if callback then
            callback(result, nil)
        end
        {{- else }}
        callback(rows[1], nil)
        {{- end }}
        {{- end }}
    end
)

end

---@class {{.GlobalLuaTable}}AsyncQueries : {{.GlobalLuaTable}}Queries
{{- range .Comments}}
-- {{ . }}
{{- end }}
{{- if .Params}}
---@param params {{.ParamsType}}
{{- end}}
---@return {{.ReturnType}}?, string|nil
function {{.GlobalLuaTable}}AsyncQueries:{{.Name}}({{- if .Params }}params{{end -}})
    local co = coroutine.running()
    local fired, r, e = false, nil, nil
    {{.GlobalLuaTable}}Queries.{{.Name}}(self, {{- if .Params }}params, {{end -}}function(result, err)
        fired = true
        r, e = result, err
        if coroutine.status(co) == "suspended" then
            local ok, resumeErr = coroutine.resume(co, result, err)
            if not ok then error(resumeErr, 0) end
        end
    end)
    if fired then return r, e end
    return coroutine.yield()
end
{{end}}
