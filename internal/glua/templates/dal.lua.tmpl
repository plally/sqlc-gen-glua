{{define "dal"}}
---@class {{.GlobalLuaTable}} : {{.GlobalLuaTable}}Queries
{{.GlobalLuaTable}} = {
    drivers = {},
    currentDriver = nil,
}

-- This function can be overwritten with your own implementation
function {{.GlobalLuaTable}}:OnError(err, query)
	print("Error running query: " .. (query or "unknown"), "\n", err)
end

---@param query string
---@param args any[]
---@param callback fun(result:any|nil, err:string|nil)
---@return any|nil, string|nil
function {{.GlobalLuaTable}}:runQuery(query, args, argCount, callback)
    self.currentDriver:Query(query, args, argCount, function(result, err)
        if err then
            self:OnError(err, query)
        end

        callback(result, err)
    end)
end

function {{.GlobalLuaTable}}:runQueryAsync(query, args, argCount)
    local co = coroutine.running()
    local fired, savedResult, savedErr = false, nil, nil

    self:runQuery(query, args, argCount, function(result, err)
        fired = true
        savedResult, savedErr = result, err
        if coroutine.status(co) == "suspended" then
            coroutine.resume(co, result, err)
        end
    end)

    if fired then
        return savedResult, savedErr
    end
    return coroutine.yield()
end

---@param callback fun(db: {{.GlobalLuaTable}}AsyncQueries)
--- NOTE: the db instance passed to the callback must not be saved or used outside of it
function {{.GlobalLuaTable}}:WithAsyncDB(callback)
	local db = setmetatable({}, {__index = {{.GlobalLuaTable}}AsyncQueries})
	db.runQuery = function(_, ...) return self:runQuery(...) end

	local co = coroutine.create(function() callback(db) end)
	local ok, err = coroutine.resume(co)
	if not ok then error(err, 0) end
end

---@param name string
---@param opts table
function {{.GlobalLuaTable}}:UseDriver(name, opts)
    self.currentDriver = self.drivers[name].constructor(opts)
end

---@param name string
---@param driver table
function {{.GlobalLuaTable}}:RegisterDriver(name, driver)
    self.drivers[name] = driver
end

---@class {{.GlobalLuaTable}}Queries
{{.GlobalLuaTable}}Queries = {}
{{.GlobalLuaTable}}Queries.__index = {{.GlobalLuaTable}}Queries

---@class {{.GlobalLuaTable}}AsyncQueries : {{.GlobalLuaTable}}Queries
{{.GlobalLuaTable}}AsyncQueries = {}
{{.GlobalLuaTable}}AsyncQueries.__index = {{.GlobalLuaTable}}AsyncQueries
setmetatable({{.GlobalLuaTable}}AsyncQueries, {__index = {{.GlobalLuaTable}}Queries})

